{
  "name": "Home Assistant Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Ajout des DNS pour corriger l'erreur de connexion Copilot (getaddrinfo EAI_AGAIN)
  "runArgs": ["--dns=8.8.8.8", "--dns=1.1.1.1"],
  "appPort": ["8123:8123"],
  "forwardPorts": [8123],
  "portsAttributes": {
    "8123": {
      "label": "Home Assistant",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "bash /workspaces/homeshift_card/.devcontainer/setup.sh",
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/config,target=/config,type=bind",
    "source=${localWorkspaceFolder}/dist,target=/config/www/workspaces/homeshift_card,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteUser": "root"
}
